[Unit]
Description=Jetson OLED system stats (SSD1306 128x64)
# Wait for the I2C bus and jetson-stats service to be ready.
After=multi-user.target jtop.service
Wants=jtop.service

[Service]
Type=simple
# Run as the owning user. Do NOT set Group= here: with only User= set,
# systemd grants all of this user's supplementary groups (i2c, jtop, ...),
# which is what gives access to /dev/i2c-7 and the jtop socket.
User=wasif
# NOTE: the project path contains spaces, so the script path MUST be quoted.
WorkingDirectory=/home/wasif/Documents/Self Driving Car/oled_stats
ExecStart=/usr/bin/python3 "/home/wasif/Documents/Self Driving Car/oled_stats/oled_stats.py"
# luma was pip-installed to the user site-packages; make sure it's importable
# even in systemd's minimal environment.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/wasif/.local/lib/python3.10/site-packages
Restart=on-failure
RestartSec=5
# Stop via SIGINT so the script's Ctrl+C handler clears the display on exit.
KillSignal=SIGINT
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
